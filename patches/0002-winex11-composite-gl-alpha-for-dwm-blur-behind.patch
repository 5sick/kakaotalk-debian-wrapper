 HRESULT WINAPI DwmEnableBlurBehindWindow(HWND hWnd, const DWM_BLURBEHIND *pBlurBuf)
 {
-    FIXME("%p %p\n", hWnd, pBlurBuf);
+    TRACE("%p %p\n", hWnd, pBlurBuf);
 
-    return E_NOTIMPL;
+    if (!pBlurBuf) return E_INVALIDARG;
+    if (!IsWindow(hWnd)) return E_HANDLE;
+
+    /* We can't blur, but apps mostly use this (with an empty blur region) to get
+     * per-pixel alpha composition of their GL/D3D content. The graphics driver
+     * looks for this property when creating the window's GL surface. */
+    if (pBlurBuf->dwFlags & DWM_BB_ENABLE)
+    {
+        if (pBlurBuf->fEnable) SetPropW(hWnd, L"__wine_dwm_blur_behind", (HANDLE)1);
+        else RemovePropW(hWnd, L"__wine_dwm_blur_behind");
+    }
+    return S_OK;
 }
 
