+/* find a config like the pixel format's one, but with an ARGB visual so that its
+ * alpha channel can be composited. Contexts are created without a config, so any
+ * config works with them. */
+static BOOL egl_find_alpha_config( int format, EGLConfig *config, XVisualInfo *visual )
+{
+    static const EGLint attribs[] =
+    {
+        EGL_RED_SIZE, EGL_GREEN_SIZE, EGL_BLUE_SIZE, EGL_ALPHA_SIZE, EGL_DEPTH_SIZE,
+        EGL_STENCIL_SIZE, EGL_SAMPLES, EGL_COLOR_BUFFER_TYPE,
+    };
+    EGLConfig base = egl_config_for_format( format );
+    EGLint want[ARRAY_SIZE(attribs)], value, type;
+    XVisualInfo template = {0}, *visuals;
+    UINT i, j;
+    int count;
+
+    for (j = 0; j < ARRAY_SIZE(attribs); j++)
+        funcs->p_eglGetConfigAttrib( egl->display, base, attribs[j], &want[j] );
+    if (!want[3]) return FALSE; /* the app didn't ask for alpha */
+
+    for (i = 0; i < egl->config_count; i++)
+    {
+        funcs->p_eglGetConfigAttrib( egl->display, egl->configs[i], EGL_SURFACE_TYPE, &type );
+        if (!(type & EGL_WINDOW_BIT)) continue;
+        for (j = 0; j < ARRAY_SIZE(attribs); j++)
+        {
+            funcs->p_eglGetConfigAttrib( egl->display, egl->configs[i], attribs[j], &value );
+            if (value != want[j]) break;
+        }
+        if (j < ARRAY_SIZE(attribs)) continue;
+
+        funcs->p_eglGetConfigAttrib( egl->display, egl->configs[i], EGL_NATIVE_VISUAL_ID, (EGLint *)&template.visualid );
+        if (!(visuals = XGetVisualInfo( gdi_display, VisualIDMask, &template, &count ))) continue;
+        *visual = *visuals;
+        XFree( visuals );
+        if (visual->depth != 32) continue;
+
+        TRACE( "using config %p with ARGB visual %#lx for format %d\n", egl->configs[i], visual->visualid, format );
+        *config = egl->configs[i];
+        return TRUE;
+    }
+
+    WARN( "no ARGB config found for format %d\n", format );
+    return FALSE;
+}
