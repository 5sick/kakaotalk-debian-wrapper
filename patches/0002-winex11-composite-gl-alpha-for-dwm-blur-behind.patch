+/***********************************************************************
+ *		reset_window_visual
+ *
+ * Go back to the default visual, unless the window GL content needs alpha composition.
+ */
+void reset_window_visual( struct x11drv_win_data *data )
+{
+    if (data->gl_alpha && argb_visual.visualid) set_window_visual( data, &argb_visual, TRUE );
+    else set_window_visual( data, &default_visual, FALSE );
+}
+
+
+/***********************************************************************
+ *		window_wants_gl_alpha
+ *
+ * Whether GL content of a top-level window should be composited with its alpha
+ * channel, which the app requests with DwmEnableBlurBehindWindow.
+ */
+BOOL window_wants_gl_alpha( HWND hwnd )
+{
+    static const WCHAR blur_behindW[] =
+        {'_','_','w','i','n','e','_','d','w','m','_','b','l','u','r','_','b','e','h','i','n','d',0};
+
+    if (!argb_visual.visualid) return FALSE;
+    if (NtUserGetAncestor( hwnd, GA_PARENT ) != NtUserGetDesktopWindow()) return FALSE;
+    return NtUserGetProp( hwnd, blur_behindW ) != 0;
+}
+
