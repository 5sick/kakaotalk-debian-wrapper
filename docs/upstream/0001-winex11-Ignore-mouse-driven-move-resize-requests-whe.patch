From d206986b4fdaa6c22b0b6c59bc127bf9b50fae97 Mon Sep 17 00:00:00 2001
From: 5sick <213179368+5sick@users.noreply.github.com>
Date: Wed, 30 Sep 2026 00:13:34 +0900
Subject: [PATCH 1/2] winex11: Ignore mouse driven move/resize requests when no
 button is pressed.

Applications (e.g. Qt based ones) can post a second SC_MOVE/SC_SIZE from a
stale mouse message after the button was already released. The key state
of the queue may then still report the button as down, so we sent
_NET_WM_MOVERESIZE to the window manager, and the window kept following
the pointer until the next click.

Check the real X pointer state when the queue says no button is pressed
and ignore mouse driven requests if no button is down. Keyboard driven
moves and sizes are unaffected.
---
 dlls/winex11.drv/mouse.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/dlls/winex11.drv/mouse.c b/dlls/winex11.drv/mouse.c
index cb79ed5..0ffa577 100644
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -1508,6 +1508,29 @@ void move_resize_window( HWND hwnd, int dir, POINT pos )
     else if (NtUserGetKeyState( VK_MBUTTON ) & 0x8000) button = 2;
     else if (NtUserGetKeyState( VK_RBUTTON ) & 0x8000) button = 3;
 
+    /* dir 0-8 are the mouse driven _NET_WM_MOVERESIZE_SIZE_* / _MOVE directions */
+    if (!button && dir <= 8)
+    {
+        int x, y, rootX, rootY;
+
+        /* the queue key state may lag behind, so check the real pointer state */
+        if (XQueryPointer( display, root_window, &root, &child, &rootX, &rootY, &x, &y, &xstate ))
+        {
+            if (xstate & Button1Mask) button = 1;
+            else if (xstate & Button2Mask) button = 2;
+            else if (xstate & Button3Mask) button = 3;
+        }
+
+        /* The drag already ended, e.g. the app posted SC_MOVE from a stale mouse
+         * message. Starting a WM move now would leave the window stuck to the
+         * pointer until the next click, so ignore the request. */
+        if (!button)
+        {
+            TRACE( "hwnd %p/%lx, dir %d, no button pressed, ignoring\n", hwnd, win, dir );
+            return;
+        }
+    }
+
     TRACE( "hwnd %p/%lx, pos %s, dir %d, button %d\n", hwnd, win, wine_dbgstr_point(&pos), dir, button );
 
     xev.xclient.type = ClientMessage;
-- 
