+
+/* create a client surface with a 32-bit ARGB visual, for GL content that needs alpha
+ * composition. The top-level X window needs an ARGB visual too, or the compositor
+ * would drop the alpha channel. */
+Window x11drv_client_surface_create_alpha( HWND hwnd, const XVisualInfo *visual, struct client_surface **client )
+{
+    struct x11drv_win_data *data;
+
+    if (!(data = get_win_data( hwnd ))) return None;
+    data->gl_alpha = TRUE;
+    set_window_visual( data, &argb_visual, TRUE );
+    release_win_data( data );
+
+    return client_surface_create_with_visual( hwnd, visual, client );
+}
