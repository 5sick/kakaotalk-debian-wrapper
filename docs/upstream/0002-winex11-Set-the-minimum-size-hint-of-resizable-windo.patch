From 68fe27e30ef9d0c8caa8c7fbd216f4264f1d0c1c Mon Sep 17 00:00:00 2001
From: 5sick <213179368+5sick@users.noreply.github.com>
Date: Wed, 30 Sep 2026 00:13:55 +0900
Subject: [PATCH 2/2] winex11: Set the minimum size hint of resizable windows.

The window manager resizes managed windows itself, but we never told it
the minimum size the application reports through WM_GETMINMAXINFO, so
resizing with the window manager could shrink a window to a thin line.

Query WM_GETMINMAXINFO (before taking the win data lock, as it sends a
message) when a resizable window is shown or resized, and set it as the
PMinSize hint, converted to the visible rect in raw pixels.
---
 dlls/winex11.drv/window.c | 36 ++++++++++++++++++++++++++++++++++++
 dlls/winex11.drv/x11drv.h |  1 +
 2 files changed, 37 insertions(+)

diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index d7df0a8..28f014e 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -946,6 +946,13 @@ static void set_size_hints( struct x11drv_win_data *data, DWORD style )
             size_hints->min_height = size_hints->max_height;
             size_hints->flags |= PMinSize | PMaxSize;
         }
+        else if (data->min_size.cx > 0 && data->min_size.cy > 0)
+        {
+            /* the WM resizes the window itself, so it needs to know the app minimum size */
+            size_hints->min_width = data->min_size.cx;
+            size_hints->min_height = data->min_size.cy;
+            size_hints->flags |= PMinSize;
+        }
     }
 
     window_set_wm_normal_hints( data, size_hints );
@@ -3262,6 +3269,31 @@ static BOOL get_desired_wm_state( DWORD style, const struct window_rects *rects
 /***********************************************************************
  *		WindowPosChanged   (X11DRV.@)
  */
+/***********************************************************************
+ *		get_min_visible_size
+ *
+ * Get the app minimum window size (WM_GETMINMAXINFO) as a minimum size of the visible
+ * rect in raw pixels, for the WM size hints. Must be called without holding win data.
+ */
+static SIZE get_min_visible_size( HWND hwnd, const struct window_rects *rects )
+{
+    MINMAXINFO info = {0};
+    UINT dpi = NtUserGetDpiForWindow( hwnd ), raw_dpi = NtUserGetWinMonitorDpi( hwnd, MDT_RAW_DPI );
+    SIZE size = {0};
+
+    if (NtUserGetWindowThread( hwnd, NULL ) != GetCurrentThreadId()) return size;
+    send_message( hwnd, WM_GETMINMAXINFO, 0, (LPARAM)&info );
+    if (info.ptMinTrackSize.x <= 0 || info.ptMinTrackSize.y <= 0 || !dpi) return size;
+
+    /* the WM hints apply to the visible rect, without the invisible borders */
+    size.cx = (INT64)info.ptMinTrackSize.x * raw_dpi / dpi
+              - ((rects->window.right - rects->window.left) - (rects->visible.right - rects->visible.left));
+    size.cy = (INT64)info.ptMinTrackSize.y * raw_dpi / dpi
+              - ((rects->window.bottom - rects->window.top) - (rects->visible.bottom - rects->visible.top));
+    if (size.cx <= 0 || size.cy <= 0) size.cx = size.cy = 0;
+    return size;
+}
+
 void X11DRV_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UINT swp_flags,
                               const struct window_rects *new_rects, struct window_surface *surface )
 {
@@ -3269,11 +3301,15 @@ void X11DRV_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UIN
     UINT ex_style = NtUserGetWindowLongW( hwnd, GWL_EXSTYLE ), new_style = NtUserGetWindowLongW( hwnd, GWL_STYLE );
     struct window_rects old_rects;
     BOOL is_managed, was_fullscreen, activate = !(swp_flags & SWP_NOACTIVATE), fullscreen = !!(swp_flags & WINE_SWP_FULLSCREEN);
+    BOOL update_min_size = (swp_flags & (SWP_SHOWWINDOW | SWP_FRAMECHANGED)) || !(swp_flags & SWP_NOSIZE);
+    SIZE min_size = {0};
 
     if ((is_managed = is_window_managed( hwnd, swp_flags, fullscreen ))) make_owner_managed( hwnd );
+    if (update_min_size && (swp_flags & WINE_SWP_RESIZABLE)) min_size = get_min_visible_size( hwnd, new_rects );
 
     if (!(data = get_win_data( hwnd ))) return;
     if (is_managed) window_set_managed( data, TRUE );
+    if (update_min_size) data->min_size = min_size;
 
     old_rects = data->rects;
     was_fullscreen = data->is_fullscreen;
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index 22462df..9c23ce5 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -681,6 +681,7 @@ struct x11drv_win_data
     Window      whole_window;   /* X window for the complete window */
     Window      client_window;  /* X window for the client area */
     struct window_rects rects;  /* window rects in monitor DPI, relative to parent client area */
+    SIZE        min_size;       /* minimum visible size from WM_GETMINMAXINFO, in raw pixels */
     struct host_window *parent; /* the host window parent, frame or embedder, NULL if root_window */
     XIC         xic;            /* X input context */
     UINT        managed : 1;    /* is window managed? */
-- 
