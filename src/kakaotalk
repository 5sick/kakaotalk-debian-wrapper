#!/bin/sh
# kakaotalk-debian-wrapper: Windows용 카카오톡을 전용 Wine prefix에서 실행하는 런처
# SPDX-License-Identifier: MIT
set -eu

APP=kakaotalk-debian-wrapper
APP_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/$APP"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/$APP"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/$APP/env"
BUNDLED_WINE="/opt/$APP/wine"
SETUP_URL_DEFAULT="https://app-pc.kakaocdn.net/talk/win32/x64/KakaoTalk_Setup.exe"

# shellcheck source=/dev/null
[ -f "$CONF" ] && . "$CONF"

# Wine 선택: KAKAOTALK_WINE > 패키지 동봉 Wine > 시스템 wine
if [ -n "${KAKAOTALK_WINE:-}" ]; then
    export PATH="$KAKAOTALK_WINE/bin:$PATH"
elif [ -x "$BUNDLED_WINE/bin/wine" ]; then
    export PATH="$BUNDLED_WINE/bin:$PATH"
fi

export WINEPREFIX="$APP_HOME/prefix"
export WINEARCH=win64
export WINEDEBUG="${WINEDEBUG:--all}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-winemenubuilder.exe=d;mscoree=d;mshtml=d}"
export LANG="${KAKAOTALK_LANG:-ko_KR.UTF-8}"
# Qt6 버전(KakaoTalkUI)용. Wine에서는 d3d11보다 OpenGL 경로가 안정적이다.
export QSG_RHI_BACKEND="${QSG_RHI_BACKEND:-opengl}"

log() { printf 'kakaotalk: %s\n' "$*" >&2; }

notify() {
    log "$*"
    command -v notify-send >/dev/null && notify-send -a KakaoTalk -i "$APP" "KakaoTalk" "$*" 2>/dev/null || true
}

die() { notify "$*"; exit 1; }

command -v wine >/dev/null || die "wine을 찾을 수 없습니다. 패키지를 다시 설치해 주세요."

# Wine은 XIM으로만 입력기를 쓰므로 실행 중인 입력기에 맞춰 XMODIFIERS를 정한다.
# 세션이 이미 XMODIFIERS를 정해뒀다면 그대로 따른다.
find_im() {
    if pgrep -x fcitx5 >/dev/null || pgrep -x fcitx >/dev/null; then echo fcitx
    elif pgrep -x ibus-daemon >/dev/null; then echo ibus
    elif pgrep -x kime >/dev/null || pgrep -x kime-xim >/dev/null; then echo kime
    elif pgrep -x nimf >/dev/null; then echo nimf
    fi
}

detect_im() {
    [ -n "${XMODIFIERS:-}" ] && return
    im=$(find_im)
    # 로그인 자동 실행 때는 입력기가 늦게 뜰 수 있으므로 잠시 기다린다.
    # 입력기 없이 먼저 뜨면 그 세션 내내 한글 입력이 안 된다.
    if [ -z "$im" ] && [ "${1:-}" = -bystartup ]; then
        tries=0
        while [ -z "$im" ] && [ $tries -lt 15 ]; do
            sleep 1
            tries=$((tries + 1))
            im=$(find_im)
        done
    fi
    [ -n "$im" ] && export XMODIFIERS="@im=$im"
    return 0
}

# GNOME에는 트레이가 없어서, AppIndicator 확장이 없으면 창을 닫았을 때 카카오톡이 사라진 것처럼 보인다
check_tray() {
    case "${XDG_CURRENT_DESKTOP:-}" in *GNOME*) ;; *) return 0 ;; esac
    stamp="$APP_HOME/.tray-checked"
    [ -e "$stamp" ] && return 0
    command -v gnome-extensions >/dev/null || return 0
    if ! gnome-extensions list --enabled 2>/dev/null | grep -qi appindicator; then
        notify "GNOME에서는 AppIndicator 확장이 있어야 트레이 아이콘이 보입니다. 창을 닫아도 카카오톡은 트레이에서 계속 실행됩니다."
    fi
    touch "$stamp"
}

edit_config() {
    if [ ! -f "$CONF" ]; then
        mkdir -p "$(dirname "$CONF")"
        cat >"$CONF" <<'EOF'
# kakaotalk-debian-wrapper 설정
# 앞의 #을 지우고 값을 바꾼 뒤 저장하세요. 카카오톡을 다시 실행하면 적용됩니다.
# (완전히 다시 실행하려면: kakaotalk --kill 후 kakaotalk)

# 카카오톡에서 보이는 폴더. 쓸 수 있는 이름: Downloads Documents Pictures Desktop Music Videos
#KAKAOTALK_SHARED_DIRS="Downloads Documents Pictures"

# 1로 하면 Wine 기본값처럼 모든 폴더와 Z: 드라이브(리눅스 전체)를 엽니다
#KAKAOTALK_FULL_ACCESS=1

# 글꼴 렌더링 엔진: directwrite(기본) | freetype(KDE/GNOME과 같은 모양) | gdi
#KAKAOTALK_FONTENGINE=freetype

# 설치 파일 주소 (기본: 카카오 공식 64비트 설치 파일)
#KAKAOTALK_SETUP_URL=https://app-pc.kakaocdn.net/talk/win32/x64/KakaoTalk_Setup.exe

# 1로 하면 ~/.cache/kakaotalk-debian-wrapper/ 에 Wine 로그를 남깁니다 (문제 보고용)
#KAKAOTALK_DEBUG=1
EOF
    fi
    if [ -t 0 ]; then
        exec ${EDITOR:-${VISUAL:-nano}} "$CONF"
    else
        exec xdg-open "$CONF"
    fi
}

reset_prefix() {
    [ -d "$APP_HOME" ] || { log "초기화할 데이터가 없습니다."; return 0; }
    if [ "${1:-}" != --yes ]; then
        [ -t 0 ] || die "확인이 필요합니다: kakaotalk --reset --yes"
        printf '%s 를 지웁니다. 카카오톡 로그인과 대화 기록 등 PC에 저장된 데이터가 모두 삭제됩니다. 계속할까요? [y/N] ' "$APP_HOME"
        read -r answer
        case "$answer" in y|Y|yes) ;; *) log "취소했습니다."; return 0 ;; esac
    fi
    wineserver -k 2>/dev/null || true
    rm -rf "$APP_HOME"
    log "초기화했습니다. 다음 실행 때 다시 설치합니다."
}

detect_dpi() {
    dpi=$(xrdb -query 2>/dev/null | awk '/^Xft.dpi:/ {print int($2)}')
    if [ -z "$dpi" ] && command -v gsettings >/dev/null; then
        scale=$(gsettings get org.gnome.desktop.interface scaling-factor 2>/dev/null | awk '{print $NF}')
        # 스키마가 없으면 gsettings가 실패한다. set -e로 런처가 끝나지 않게 한다
        text=$(gsettings get org.gnome.desktop.interface text-scaling-factor 2>/dev/null) || text=
        dpi=$(awk -v s="${scale:-0}" -v t="${text:-1}" 'BEGIN { if (s < 1) s = 1; printf "%d", 96 * s * t + 0.5 }')
    fi
    echo "${dpi:-96}"
}

# Qt 폰트 엔진: directwrite(Qt 기본) | freetype(KDE/GNOME과 같은 렌더링) | gdi
apply_fontengine() {
    case "${KAKAOTALK_FONTENGINE:-directwrite}" in
        freetype|gdi) export QT_QPA_PLATFORM="windows:fontengine=$KAKAOTALK_FONTENGINE" ;;
    esac
}

# 시스템 CJK 폰트를 prefix 폰트 폴더에 링크 (Qt freetype 엔진은 파일 경로가 필요)
link_fonts() {
    fontdir="$WINEPREFIX/drive_c/windows/Fonts"
    for f in /usr/share/fonts/opentype/noto/NotoSansCJK-*.ttc /usr/share/fonts/opentype/noto/NotoSerifCJK-*.ttc; do
        [ -e "$f" ] || continue
        [ -e "$fontdir/${f##*/}" ] || ln -s "$f" "$fontdir/${f##*/}"
    done
}

# 이 prefix의 wineserver가 떠 있는지 (Wine은 /tmp/.wine-<uid>/server-<dev>-<inode>/socket을 쓴다)
prefix_running() {
    # shellcheck disable=SC2046  # 장치 번호와 inode 두 값으로 나눈다
    set -- $(stat -Lc '%d %i' "$WINEPREFIX" 2>/dev/null) || return 1
    [ $# -eq 2 ] && [ -S "/tmp/.wine-$(id -u)/server-$(printf '%x-%x' "$1" "$2")/socket" ]
}

# 카카오톡(Windows 쪽)에서 보이는 리눅스 폴더를 제한한다. 보안 샌드박스는 아니고,
# Wine 기본값(Z: = /, Templates = 홈 전체)처럼 불필요하게 넓게 열어두지 않는 정도다.
# Wine이 prefix를 업데이트할 때 연결을 다시 만들기 때문에 실행할 때마다 적용한다.
apply_file_access() {
    userdir="$WINEPREFIX/drive_c/users/${USER:-$(id -un)}"
    shared=" ${KAKAOTALK_SHARED_DIRS-Downloads Documents Pictures} "
    [ -n "${KAKAOTALK_FULL_ACCESS:-}" ] && shared=" Desktop Documents Downloads Music Pictures Videos "

    for entry in Desktop:DESKTOP Documents:DOCUMENTS Downloads:DOWNLOAD Music:MUSIC Pictures:PICTURES Videos:VIDEOS; do
        name=${entry%%:*}
        link="$userdir/$name"
        target=$(xdg-user-dir "${entry#*:}" 2>/dev/null || true)
        [ -n "$target" ] || target="$HOME/$name"
        case "$shared" in
            *" $name "*)
                [ "$target" != "$HOME" ] && [ -d "$target" ] || continue
                if [ -L "$link" ] || [ ! -e "$link" ]; then
                    ln -sfn "$target" "$link"
                elif ! rmdir "$link" 2>/dev/null; then
                    log "$link 에 파일이 있어서 $target 에 연결하지 않았습니다"
                else
                    ln -s "$target" "$link"
                fi ;;
            *)
                [ -L "$link" ] && rm -f "$link"
                mkdir -p "$link" ;;
        esac
    done

    templates="$userdir/AppData/Roaming/Microsoft/Windows/Templates"
    [ -L "$templates" ] && rm -f "$templates" && mkdir -p "$templates"

    # 공유 폴더 밖의 파일: 파일 선택 창은 여기에 복사해 두고(patches/0005), 끌어다 놓거나
    # 붙여넣은 파일은 여기에 링크한다(patches/0007). 카카오톡이 실행 중이 아닐 때만 지운다.
    if ! prefix_running; then
        rm -rf "$userdir/AppData/Local/Temp/host-files" "$WINEPREFIX/drive_c/windows/temp/host-files"
    fi

    if [ -n "${KAKAOTALK_FULL_ACCESS:-}" ]; then
        ln -sfn / "$WINEPREFIX/dosdevices/z:"
    else
        rm -f "$WINEPREFIX/dosdevices/z:"
    fi
}

find_exe() {
    for d in "$WINEPREFIX/drive_c/users/${USER:-$(id -un)}/AppData/Local/Programs/Kakao/KakaoTalk" \
             "$WINEPREFIX/drive_c/Program Files/Kakao/KakaoTalk" \
             "$WINEPREFIX/drive_c/Program Files (x86)/Kakao/KakaoTalk"; do
        for exe in "$d/bin/KakaoTalkUI.exe" "$d/KakaoTalk.exe"; do
            [ -f "$exe" ] && { echo "$exe"; return; }
        done
    done
    find "$WINEPREFIX/drive_c" \( -name KakaoTalkUI.exe -o -name KakaoTalk.exe \) -print -quit 2>/dev/null
}

# prefix 레지스트리 설정. 내용을 바꾸면 TWEAKS_VERSION을 올려서 기존 prefix에도 다시 적용되게 한다.
TWEAKS_VERSION=6
OPEN_HELPER="/usr/lib/$APP/open"

apply_tweaks() {
    dpi=$(detect_dpi)
    stamp="$APP_HOME/.tweaks-version"
    [ "$(cat "$stamp" 2>/dev/null)" = "$TWEAKS_VERSION:$dpi" ] && return
    mkdir -p "$WINEPREFIX/drive_c/crashdumps"
    reg=$(mktemp --suffix=.reg)
    # 한글 값이 있으므로 UTF-16 .reg(버전 5)로 쓴다. REGEDIT4는 ANSI(CP949)로 읽혀 깨진다.
    { tweaks_reg; open_with_linux_reg; } | iconv -f UTF-8 -t UTF-16 >"$reg"
    # /reg:64: 64비트 뷰에 써야 64비트 카카오톡이 읽는다 (Wow6432Node 아님)
    wine reg import "$reg" /reg:64 >/dev/null 2>&1
    wineserver -w
    rm -f "$reg"
    echo "$TWEAKS_VERSION:$dpi" >"$stamp"
}

# 카카오톡에서 받은 파일을 열 때 Wine 쪽 프로그램(또는 연결 없음) 대신 리눅스 기본 앱으로 연다
OPEN_WITH_LINUX_EXTS="txt log csv jpg jpeg png gif bmp webp heic svg mp4 mov avi mkv webm m4v
    mp3 m4a wav ogg flac aac pdf doc docx xls xlsx ppt pptx hwp hwpx odt ods odp rtf zip 7z rar
    tar gz html htm"

open_with_linux_reg() {
    cat <<EOF
[HKEY_CLASSES_ROOT\\LinuxDefaultApp\\shell\\open\\command]
@="\\"C:\\\\windows\\\\system32\\\\winebrowser.exe\\" \\"%1\\""

EOF
    for ext in $OPEN_WITH_LINUX_EXTS; do
        printf '[HKEY_CLASSES_ROOT\\.%s]\n@="LinuxDefaultApp"\n\n' "$ext"
    done
}

tweaks_reg() {
    cat <<EOF
Windows Registry Editor Version 5.00

[-HKEY_CURRENT_USER\\Software\\Wine\\Fonts\\Replacements]

[HKEY_CURRENT_USER\\Software\\Wine\\Fonts\\Replacements]
"Malgun Gothic"="Noto Sans CJK KR"
"맑은 고딕"="Noto Sans CJK KR"
"Segoe UI"="Noto Sans CJK KR"
"Gulim"="Noto Sans CJK KR"
"GulimChe"="Noto Sans CJK KR"
"굴림"="Noto Sans CJK KR"
"굴림체"="Noto Sans CJK KR"
"Dotum"="Noto Sans CJK KR"
"DotumChe"="Noto Sans CJK KR"
"돋움"="Noto Sans CJK KR"
"돋움체"="Noto Sans CJK KR"
"Batang"="Noto Serif CJK KR"
"BatangChe"="Noto Serif CJK KR"
"바탕"="Noto Serif CJK KR"
"바탕체"="Noto Serif CJK KR"
"Gungsuh"="Noto Serif CJK KR"
"GungsuhChe"="Noto Serif CJK KR"
"궁서"="Noto Serif CJK KR"
"궁서체"="Noto Serif CJK KR"

[HKEY_CURRENT_USER\\Control Panel\\Desktop]
"LogPixels"=dword:$(printf '%08x' "$dpi")

; 폴더는 Wine 탐색기 대신 리눅스 파일 관리자로 연다.
; winebrowser가 경로를 file:// 로 바꿔 OPEN_HELPER(없으면 xdg-open)에 넘긴다.
[HKEY_CURRENT_USER\\Software\\Wine\\WineBrowser]
"Browsers"="$OPEN_HELPER,xdg-open"

[HKEY_CLASSES_ROOT\\Folder\\shell\\open\\command]
@="\\"C:\\\\windows\\\\system32\\\\winebrowser.exe\\" \\"%1\\""

; ddeexec가 있으면 명령 대신 DDE로 Wine 탐색기에 요청하므로 지운다
[-HKEY_CLASSES_ROOT\\Folder\\shell\\open\\ddeexec]

[HKEY_CLASSES_ROOT\\Directory\\shell\\open\\command]
@="\\"C:\\\\windows\\\\system32\\\\winebrowser.exe\\" \\"%1\\""

; "폴더 열기"(explorer.exe /select,파일 또는 SHOpenFolderAndSelectItems)는 연결을 거치지 않고
; Wine 탐색기를 직접 띄운다. 패치된 Wine(patches/0004)은 이 값이 있으면 대신
; "OPEN_HELPER --select 리눅스경로"를 실행해서 리눅스 파일 관리자에서 파일을 선택해 보여준다.
[HKEY_CURRENT_USER\\Software\\Wine\\Explorer]
"HostFileManager"="$OPEN_HELPER"

; 파일 첨부/저장 창을 Wine 창 대신 리눅스 파일 선택 창(xdg-desktop-portal)으로 띄운다 (patches/0005).
; 포털이 없으면 Wine 창이 그대로 뜬다.
[HKEY_CURRENT_USER\\Software\\Wine\\FileDialog]
"HostFileChooser"="Y"

; 크래시 시 winedbg가 멈춰 있지 않고 덤프만 남기고 끝나게 한다
[HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Windows NT\\CurrentVersion\\AeDebug]
"Debugger"="winedbg --minidump C:\\\\crashdumps\\\\kakaotalk.mdmp %ld %ld"
"Auto"="1"

EOF
}

init_prefix() {
    if [ ! -f "$WINEPREFIX/system.reg" ]; then
        notify "처음 실행 준비 중입니다. 잠시만 기다려 주세요."
        mkdir -p "$APP_HOME"
        wineboot -i >/dev/null 2>&1
        wineserver -w
    fi
    apply_tweaks
}

find_setup() {
    for f in "$HOME/Downloads/KakaoTalk_Setup.exe" "$HOME/다운로드/KakaoTalk_Setup.exe"; do
        [ -f "$f" ] && { echo "$f"; return; }
    done
    url="${KAKAOTALK_SETUP_URL:-$SETUP_URL_DEFAULT}"
    mkdir -p "$CACHE_DIR"
    notify "카카오 공식 서버에서 설치 파일을 내려받는 중입니다."
    curl -fL --retry 3 -o "$CACHE_DIR/KakaoTalk_Setup.exe.part" "$url" >&2 || die "설치 파일을 내려받지 못했습니다: $url"
    mv "$CACHE_DIR/KakaoTalk_Setup.exe.part" "$CACHE_DIR/KakaoTalk_Setup.exe"
    echo "$CACHE_DIR/KakaoTalk_Setup.exe"
}

install_app() {
    setup="${1:-}"
    [ -n "$setup" ] || setup=$(find_setup)
    [ -f "$setup" ] || die "설치 파일이 없습니다: $setup"
    log "설치: $setup"
    # 카카오 이용약관을 사용자가 직접 확인하도록 기본은 설치 화면을 그대로 띄운다
    if [ -n "${KAKAOTALK_SILENT_INSTALL:-}" ]; then
        wine "$setup" /S
    else
        wine "$setup"
    fi
}

# 설치된 exe에서 아이콘을 추출하고, 창 그룹핑용 StartupWMClass를 맞춘 사용자 .desktop을 만든다
integrate_desktop() {
    exe="$1"
    class=$(basename "$exe" | tr 'A-Z' 'a-z')
    stamp="$APP_HOME/.desktop-integrated"
    [ "$(cat "$stamp" 2>/dev/null)" = "$class" ] && return

    icondir="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/256x256/apps"
    if command -v wrestool >/dev/null && command -v icotool >/dev/null; then
        tmp=$(mktemp -d)
        if wrestool -x -t 14 "$exe" >"$tmp/app.ico" 2>/dev/null && [ -s "$tmp/app.ico" ]; then
            icotool -x -o "$tmp" "$tmp/app.ico" 2>/dev/null || true
            png=$(ls -S "$tmp"/*.png 2>/dev/null | head -1)
            [ -n "$png" ] && mkdir -p "$icondir" && cp "$png" "$icondir/$APP.png"
        fi
        rm -rf "$tmp"
    fi

    src="/usr/share/applications/$APP.desktop"
    if [ -f "$src" ]; then
        appdir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
        mkdir -p "$appdir"
        sed "s/^StartupWMClass=.*/StartupWMClass=$class/" "$src" >"$appdir/$APP.desktop"
    fi
    echo "$class" >"$stamp"
}

# 카카오톡 설정의 "자동 실행"은 Windows처럼 HKCU\...\Run 에 값을 넣는다. Wine은 로그인 때 이 값을
# 실행하지 않으므로, 패키지의 /etc/xdg/autostart 항목이 로그인할 때 --autostart-check로 대신 확인한다.
# 그래서 카카오톡 설정의 자동 실행과 kakaotalk --autostart가 같은 값을 쓴다.
RUN_KEY='HKCU\Software\Microsoft\Windows\CurrentVersion\Run'

# user.reg의 Run 키에서 카카오톡을 실행하는 값의 이름 (없으면 출력 없음)
autostart_value() {
    [ -f "$WINEPREFIX/user.reg" ] || return 0
    awk '
        /^\[/ { inrun = (index($0, "[Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run]") == 1); next }
        inrun && /KakaoTalk(UI)?\.exe/ { sub(/^"/, ""); sub(/"=.*/, ""); print; exit }
    ' "$WINEPREFIX/user.reg"
}

set_autostart() {
    # 예전 버전(0.2.x)이 만든 사용자 자동 시작 항목은 같은 이름의 시스템 항목을 가리므로 지운다
    rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/autostart/$APP.desktop"
    case "${1:-}" in
        on)
            init_prefix
            exe=$(find_exe)
            [ -n "$exe" ] || die "카카오톡이 설치되어 있지 않습니다."
            win=$(winepath -w "$exe" 2>/dev/null)
            wine reg add "$RUN_KEY" /v Talk /t REG_SZ /d "\"$win\" -bystartup" /f >/dev/null 2>&1 ||
                die "자동 실행을 켜지 못했습니다."
            log "로그인할 때 트레이로 자동 실행합니다. (카카오톡 설정의 자동 실행과 같은 설정입니다)" ;;
        off)
            name=$(autostart_value)
            [ -n "$name" ] && wine reg delete "$RUN_KEY" /v "$name" /f >/dev/null 2>&1
            log "자동 실행을 껐습니다." ;;
        status)
            if [ -n "$(autostart_value)" ]; then echo on; else echo off; fi ;;
        *)  die "사용법: kakaotalk --autostart on|off|status" ;;
    esac
}

# D-Bus 서비스 상태: 실행 중 | 필요할 때 실행됨 | 없음
dbus_name_state() {
    command -v dbus-send >/dev/null || { echo "확인 불가 (dbus-send 없음)"; return; }
    names=$(dbus-send --session --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus \
        org.freedesktop.DBus.ListNames 2>/dev/null) || { echo "확인 불가 (세션 버스 없음)"; return; }
    if printf '%s' "$names" | grep -q "\"$1\""; then echo "실행 중"; return; fi
    names=$(dbus-send --session --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus \
        org.freedesktop.DBus.ListActivatableNames 2>/dev/null) || names=
    if printf '%s' "$names" | grep -q "\"$1\""; then echo "필요할 때 실행됨"; else echo "없음"; fi
}

# 문제 보고용 환경 정보. 홈 폴더 경로는 ~로 바꿔서 출력한다.
report() {
    exe=$(find_exe || true)
    im=$(find_im || true)
    {
        echo "### 환경"
        echo "- 패키지: $(dpkg-query -W -f='${Version}' "$APP" 2>/dev/null || echo '설치 안 됨 (소스에서 실행)')"
        echo "- 배포판: $( (. /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-?}") || echo '?'), 커널 $(uname -r)"
        echo "- 데스크톱: ${XDG_CURRENT_DESKTOP:-?} / 세션 ${XDG_SESSION_TYPE:-?}$([ -n "${WAYLAND_DISPLAY:-}" ] && echo ' (Wayland, 카카오톡은 XWayland)')"
        echo "- 입력기: ${im:-감지 안 됨} / XMODIFIERS=${XMODIFIERS:-없음} / GTK_IM_MODULE=${GTK_IM_MODULE:-없음} / QT_IM_MODULE=${QT_IM_MODULE:-없음}"
        echo "- 화면 DPI: $(detect_dpi)"
        if command -v glxinfo >/dev/null; then
            echo "- OpenGL: $(glxinfo -B 2>/dev/null | sed -n 's/^OpenGL renderer string: //p')"
        fi
        echo "- 한글 글꼴(Noto Sans CJK KR): $(fc-list 2>/dev/null | grep -c 'Noto Sans CJK KR') 개"
        echo "- 파일 선택 창 포털: $(dbus_name_state org.freedesktop.portal.Desktop)"
        echo "- 파일 관리자(FileManager1): $(dbus_name_state org.freedesktop.FileManager1)"
        case "${XDG_CURRENT_DESKTOP:-}" in
            *GNOME*)
                if gnome-extensions list --enabled 2>/dev/null | grep -qi appindicator; then
                    echo "- GNOME 트레이 확장: 켜짐"
                else
                    echo "- GNOME 트레이 확장: 꺼짐 또는 없음"
                fi ;;
        esac
        echo
        echo "### Wine / 카카오톡"
        echo "- Wine: $(wine --version 2>/dev/null || echo '?') ($(command -v wine))"
        echo "- prefix: $([ -f "$WINEPREFIX/system.reg" ] && echo '있음' || echo '없음'), 설정 버전 $(cat "$APP_HOME/.tweaks-version" 2>/dev/null || echo '?')"
        echo "- 카카오톡: ${exe:-설치 안 됨}"
        echo "- Z: 드라이브: $([ -e "$WINEPREFIX/dosdevices/z:" ] && echo '있음' || echo '없음')"
        echo "- 자동 실행: $(if [ -n "$(autostart_value)" ]; then echo on; else echo off; fi)"
        echo "- 크래시 덤프: $(find "$WINEPREFIX/drive_c/crashdumps" -name '*.mdmp' 2>/dev/null | wc -l) 개"
        echo "- 실행 중: $(if prefix_running; then echo 예; else echo 아니오; fi)"
        echo
        echo "### 설정 ($CONF)"
        if [ -f "$CONF" ] && grep -q '^[^#[:space:]]' "$CONF"; then
            grep '^[^#[:space:]]' "$CONF" | sed 's/^/    /'
        else
            echo "    (기본값)"
        fi
    } | sed -e "s|$HOME|~|g" -e "s|/users/${USER:-$(id -un)}/|/users/<사용자>/|g"
}

usage() {
    cat <<EOF
사용법: kakaotalk [옵션] [카카오톡 인자...]

  (옵션 없음)            카카오톡 실행 (처음이면 설치부터 진행)
  --install [설치파일]   카카오톡 설치/재설치 (파일을 주지 않으면 공식 서버에서 받음)
  --autostart on|off|status
                         로그인 시 자동 실행 (카카오톡 설정의 자동 실행과 같은 설정)
  --config               설정 파일 열기 (공유 폴더, 글꼴 엔진 등)
  --winecfg              Wine 설정 열기
  --kill                 카카오톡과 Wine 프로세스 강제 종료
  --reset [--yes]        카카오톡 데이터(Wine prefix) 전체 삭제 후 초기화
  --report               문제 보고용 환경 정보 출력 (이슈에 붙여넣기)
  --help                 이 도움말

설정 파일: $CONF
  KAKAOTALK_FONTENGINE=freetype   글꼴 렌더링 엔진 (directwrite|freetype|gdi)
  KAKAOTALK_SETUP_URL=...         설치 파일 주소 (기본: 예전 UI 64비트)
  KAKAOTALK_SHARED_DIRS="Downloads Documents Pictures"
                                  카카오톡에서 보이는 폴더 (Desktop Music Videos 추가 가능)
  KAKAOTALK_FULL_ACCESS=1         Wine 기본값처럼 모든 폴더와 Z:(/) 드라이브 열기
  KAKAOTALK_DEBUG=1               $CACHE_DIR 에 Wine 로그 저장
EOF
}

case "${1:-}" in
    --help|-h) usage; exit ;;
    --init)    init_prefix; exit ;;
    --install) init_prefix; install_app "${2:-}"; exe=$(find_exe); [ -n "$exe" ] && integrate_desktop "$exe"; exit ;;
    --autostart) set_autostart "${2:-}"; exit ;;
    --autostart-check)
        # 로그인 때 /etc/xdg/autostart 항목이 부른다. 자동 실행이 꺼져 있으면 아무것도 하지 않는다.
        [ -n "$(autostart_value)" ] || exit 0
        set -- -bystartup ;;
    --reset)   reset_prefix "${2:-}"; exit ;;
    --report)  report; exit ;;
    --config)  edit_config ;;
    --winecfg) exec winecfg ;;
    --kill)    exec wineserver -k ;;
esac

init_prefix
exe=$(find_exe)
if [ -z "$exe" ]; then
    install_app
    exe=$(find_exe)
    [ -n "$exe" ] || die "카카오톡 설치에 실패했습니다."
fi
integrate_desktop "$exe"

detect_im "${1:-}"
check_tray
link_fonts
apply_file_access
apply_fontengine
cd "$(dirname "$exe")"

# KAKAOTALK_DEBUG=1: DLL 로드 주소와 예외를 로그 파일에 남긴다 (크래시 분석용)
if [ -n "${KAKAOTALK_DEBUG:-}" ]; then
    mkdir -p "$CACHE_DIR"
    logfile="$CACHE_DIR/wine-$(date +%Y%m%d-%H%M%S).log"
    # 창 이동 추적은 KAKAOTALK_WINEDEBUG=err+all,fixme-all,+loaddll,+seh,trace+cursor
    export WINEDEBUG="${KAKAOTALK_WINEDEBUG:-err+all,fixme-all,+loaddll,+seh}"
    log "디버그 로그: $logfile"
    exec wine "$exe" "$@" 2>"$logfile"
fi
exec wine "$exe" "$@"
